# Copy this file to `.env` and fill in your values, then export them
# (e.g. `export $(grep -v '^#' .env | xargs)`).

# --- Required -------------------------------------------------------------

# OpenAI API key used to call the AI model (gpt-4o-mini).
OPENAI_API_KEY=sk-...

# GitHub personal access token with `repo` scope.
# Must have push access to the target repository (typically a fork you own).
GITHUB_TOKEN=ghp_...

# --- Optional: GitHub repos -----------------------------------------------

# Repository to push the new branch to and open the PR against.
# Format: owner/repo. Defaults to the source repo.
# Set this to a fork/own repo when your token can't push to the source.
# GITHUB_TARGET_REPO=your-username/your-fork

# Repository to read TypeScript files from. Format: owner/repo.
# Overrides the hardcoded source repo (see src/config.ts).
# GITHUB_SOURCE_REPO=your-username/your-repo

# --- Optional: coverage-driven prioritisation -----------------------------

# Path to an lcov.info file. When present, files with line coverage below
# COVERAGE_THRESHOLD are processed first.
# COVERAGE_FILE=./coverage/lcov.info

# Line-coverage percentage threshold (default: 80).
# COVERAGE_THRESHOLD=80

# --- Optional: persistence ------------------------------------------------

# Path to the SQLite database file (default: ./testforge.db).
# TESTFORGE_DB_PATH=./testforge.db

# --- Optional: security ---------------------------------------------------

# By default the AI integration runs in an isolated worker_thread with a
# stripped environment (no GITHUB_TOKEN, no DB path, no coverage path).
# Set this to "1" to disable the sandbox and run the AI in-process
# (useful for debugging only — leaks all env vars to the AI code path).
# TESTFORGE_AI_INPROCESS=0
